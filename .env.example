# Operator-only secrets. These are NEVER required for anonymous candidates
# (V1 is BYO API key — see R5/R6 in the requirements doc).

# Optional: operator's own keys for dev/dogfooding (U6 will read these
# when X-Operator-Token matches).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Operator auth (R21): private framework loading + dogfooding.
# Set both to enable F4 operator-only private prep flow.
OPERATOR_SECRET=
# JSON-encoded array of framework objects. Loaded at server-render only,
# never bundled into client JS. See docs/brainstorms/...-requirements.md R21.
OPERATOR_PRIVATE_FRAMEWORKS=

# Per-IP rate limiting on /api/* routes. When both are set, requests are
# throttled via Upstash Redis (REST). When unset, the limiters degrade to
# no-op — fine for local dev, but DO NOT ship to public production without
# them or any caller can flood /api/validate-key and /api/interview.
#
# Easiest setup: Vercel → Integrations → Upstash → connect; the two vars
# below are injected automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
